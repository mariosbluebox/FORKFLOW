{
  "name": "restaurant-finance",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:weekly-snapshot": "TS_NODE_PROJECT=scripts/tsconfig.json ts-node -r tsconfig-paths/register scripts/verify-weekly-snapshot.ts",
    "seed:weekly-snapshot": "TS_NODE_PROJECT=scripts/tsconfig.json ts-node -r tsconfig-paths/register scripts/seed-weekly-snapshot-fixture.ts",
    "verify:channel-expectancy": "TS_NODE_PROJECT=scripts/tsconfig.json ts-node -r tsconfig-paths/register scripts/verify-channel-expectancy.ts",
    "verify:promo-expectancy": "TS_NODE_PROJECT=scripts/tsconfig.json ts-node -r tsconfig-paths/register scripts/verify-promo-expectancy.ts",
    "verify:labour-expectancy": "TS_NODE_PROJECT=scripts/tsconfig.json ts-node -r tsconfig-paths/register scripts/verify-labour-expectancy.ts",
    "verify:ingredient-expectancy": "TS_NODE_PROJECT=scripts/tsconfig.json ts-node -r tsconfig-paths/register scripts/verify-ingredient-expectancy.ts",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "secretlint --secretlintignore .gitignore"
    ],
    "*.{json,md,yml,yaml}": [
      "secretlint --secretlintignore .gitignore"
    ]
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@react-pdf/renderer": "4.3.2",
    "bcryptjs": "3.0.3",
    "next": "15.5.18",
    "next-auth": "4.24.13",
    "prisma": "5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "3.7.0",
    "stripe": "20.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.19.35",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-config-next": "15.5.12",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "secretlint": "^13.0.2",
    "tailwindcss": "4.2.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
